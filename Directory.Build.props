<Project>
  <!-- Keep all SDK version metadata derived from the repository version file. -->
  <PropertyGroup>
    <RepositoryVersionFile>$(MSBuildThisFileDirectory)build\version.txt</RepositoryVersionFile>
    <RepositoryVersionRaw Condition="Exists('$(RepositoryVersionFile)')">$([System.IO.File]::ReadAllText('$(RepositoryVersionFile)'))</RepositoryVersionRaw>
    <RepositoryVersion Condition="'$(RepositoryVersionRaw)' != ''">$([System.String]::Copy('$(RepositoryVersionRaw)').Trim())</RepositoryVersion>
    <RepositoryVersion Condition="$([System.String]::Copy('$(RepositoryVersion)').StartsWith('v'))">$([System.String]::Copy('$(RepositoryVersion)').Substring(1))</RepositoryVersion>

    <Version Condition="'$(RepositoryVersion)' != ''">$(RepositoryVersion)</Version>
    <PackageVersion Condition="'$(RepositoryVersion)' != ''">$(RepositoryVersion)</PackageVersion>
    <InformationalVersion Condition="'$(RepositoryVersion)' != ''">$(RepositoryVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="ValidateRepositoryVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(RepositoryVersionFile)')" Text="Version file not found: $(RepositoryVersionFile)" />
    <Error Condition="'$(RepositoryVersion)' == ''" Text="Version file is empty: $(RepositoryVersionFile)" />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RepositoryVersion)', '^\d+\.\d+\.\d+(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$')) != 'True'" Text="Invalid version in $(RepositoryVersionFile): $(RepositoryVersion)" />
  </Target>
</Project>
